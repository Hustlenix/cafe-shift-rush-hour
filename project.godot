; Godot 4.3+ project - open this directory with Godot's Import button.
config_version=5

[application]
config/name="CAFÉ SHIFT — Rush Hour"
config/description="A little cafe. Five happy tables. A lovely afternoon."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
OrderStore="*res://scripts/order_store.gd"
KitchenSync="*res://scripts/kitchen_sync.gd"

[display]
window/size/viewport_width=1360
window/size/viewport_height=860
window/size/window_width_override=1360
window/size/window_height_override=860
window/stretch/mode="canvas_items"
window/size/min_width=960
window/size/min_height=620

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
