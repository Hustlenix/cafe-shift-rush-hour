{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "builds/web",
  "regions": ["sin1"],
  "rewrites": [{"source":"/api/:path*","destination":"/api"}],
  "headers": [
    {"source":"/release.json","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"}]},
    {"source":"/index.wasm","headers":[{"key":"Content-Type","value":"application/wasm"}]},
    {"source":"/index.pck","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]}
  ]
}
